SERPAPI_API_KEY=your_serpapi_key_here

# 免費額度優先：SerpAPI 為主；填入 Amadeus 憑證後可自動備援
FLIGHT_API_PROVIDER=serpapi
FLIGHT_API_FALLBACK=amadeus
SERPAPI_MONTHLY_LIMIT=250
API_USAGE_WARNING_PERCENT=80

# 可選 Amadeus Self-Service 備援；test=快取測試資料，production=即時資料
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
AMADEUS_MONTHLY_LIMIT=0

# 僅達到目標價時補查回程與開票平台，平常排程維持一次主查詢
MONITOR_FETCH_DETAILS_ON_HIT=true

DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# true=每次查價都通知；false=僅達標或價格變動時通知
ALWAYS_NOTIFY=true

# 同一監控在 N 小時內不重複推播
NOTIFY_COOLDOWN_HOURS=6
MESSAGE_DEDUPE_HOURS=24

# 固定每日檢查時間；若改用間隔模式，清空此值並設定 CHECK_INTERVAL_MINUTES
SCHEDULE_HOURS=0,12
CHECK_INTERVAL_MINUTES=
