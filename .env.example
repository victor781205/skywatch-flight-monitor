SERPAPI_API_KEY=your_serpapi_key_here
TRAVELPAYOUTS_TOKEN=

# 每筆監控的精簡／標準／完整模式會將單次請求硬限制為 1／2／5 次
SERPAPI_MONTHLY_LIMIT=250
API_USAGE_WARNING_PERCENT=80

# 允許標準／完整模式補查回程；完整模式優先補三大國籍航空
MONITOR_FETCH_DETAILS_ON_HIT=true

DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 可接受多個聊天室 ID，以逗號分隔；未設定時沿用 TELEGRAM_CHAT_ID
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,-987654321
# 獨立的 long-polling 指令服務：/status、/quota、/check
TELEGRAM_COMMANDS_ENABLED=true
# 群組使用 @BotName 指令時建議填入，不含 @
TELEGRAM_BOT_USERNAME=

# true=每次查價都通知；false=僅達標或價格變動時通知
ALWAYS_NOTIFY=true

# 僅供手動觸發的選用冷卻；固定排程與 outbox 重試不受影響，建議維持 0
NOTIFY_COOLDOWN_HOURS=0
MESSAGE_DEDUPE_HOURS=24

# 固定每日檢查時間；若改用間隔模式，清空此值並設定 CHECK_INTERVAL_MINUTES
SCHEDULE_HOURS=0,12
CHECK_INTERVAL_MINUTES=
SCHEDULER_TICK_MINUTES=5
SCHEDULER_HEARTBEAT_STALE_MINUTES=15
MISSED_RUN_LOOKBACK_HOURS=24
OUTBOX_MAX_ATTEMPTS=4
